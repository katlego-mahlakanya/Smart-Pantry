<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp" android:layout_marginBottom="6dp" android:background="#F1F8E9">
    <TextView android:id="@+id/txtItemName" android:layout_width="match_parent" android:layout_height="wrap_content" android:textStyle="bold" android:textSize="18sp" android:textColor="#1B5E20"/>
    <TextView android:id="@+id/txtItemDetails" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="14sp"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <Button android:id="@+id/btnEditItem" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Edit"/>
        <Button android:id="@+id/btnDeleteItem" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Delete"/>
    </LinearLayout>
</LinearLayout>

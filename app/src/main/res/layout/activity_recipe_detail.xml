<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
        <TextView android:id="@+id/txtRecipeName" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="25sp" android:textStyle="bold" android:textColor="#2E7D32"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Ingredients" android:textSize="19sp" android:textStyle="bold" android:paddingTop="16dp"/>
        <TextView android:id="@+id/txtRecipeIngredients" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="16sp" android:paddingTop="6dp"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Preparation method" android:textSize="19sp" android:textStyle="bold" android:paddingTop="16dp"/>
        <TextView android:id="@+id/txtRecipeSteps" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="16sp" android:paddingTop="6dp"/>
        <Button android:id="@+id/btnRecipeBack" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Back to recipes" android:layout_marginTop="16dp"/>
    </LinearLayout>
</ScrollView>

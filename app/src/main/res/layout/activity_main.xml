<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Smart Pantry Manager" android:textSize="25sp" android:textStyle="bold" android:textColor="#2E7D32" android:paddingBottom="8dp"/>
    <TextView android:id="@+id/txtPantryCount" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Your ingredients" android:textSize="16sp" android:paddingBottom="8dp"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <Button android:id="@+id/btnAdd" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Add ingredient"/>
        <Button android:id="@+id/btnSuggestions" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Recipes"/>
    </LinearLayout>
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/recyclerPantry" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:paddingTop="8dp"/>
    <Button android:id="@+id/btnSettings" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Settings"/>
</LinearLayout>
